{
  "name": "learn-english",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:pages": "node scripts/build-pages.mjs",
    "test": "ng test --no-watch",
    "lint": "ng lint && prettier --check .",
    "format": "prettier --write .",
    "schema:generate": "node scripts/generate-schema.mjs",
    "exams:index": "node scripts/generate-index.mjs",
    "exams:migrate-v1": "node scripts/migrate-v1-to-v2.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "validate:exams": "node scripts/validate-exams.mjs",
    "validate:grammar": "node scripts/validate-grammar.mjs",
    "test:scripts": "node --test scripts/lib/exam-rules.test.mjs scripts/lib/grammar-rules.test.mjs scripts/lib/exam-builders.test.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "images:optimize": "node scripts/optimize-images.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
