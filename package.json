    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
